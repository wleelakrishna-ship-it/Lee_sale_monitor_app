# Claude Code local settings (contains an API auth token — never commit)
.claude/

# Release signing config (contains the keystore path and passwords — never commit)
android/key.properties
*.jks
*.keystore

# Supabase / runtime config (contains the anon key and environment URLs — never commit)
env/dev.json
env/prod.json
tools/**/service-account.json

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Kotlin compiler session files
android/.kotlin/

# Node modules (firebase claim script)
tools/firebase_claim/node_modules/
tools/firebase_claim/package-lock.json
